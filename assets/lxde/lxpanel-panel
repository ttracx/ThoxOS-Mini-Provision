# ThoxOS Mini panel -> ~/.config/lxpanel/LXDE/panels/panel
Global {
  edge=bottom
  align=left
  margin=0
  widthtype=percent
  width=100
  height=30
  transparent=1
  tintcolor=#0B0F14
  alpha=235
  setdocktype=1
  setpartialstrut=1
  usefontcolor=1
  fontcolor=#F2F6F9
  background=0
}
Plugin { type=menu Config { image=/usr/share/icons/ThoxOSMini/logo.png } }
Plugin { type=launchbar Config { Button { id=lxterminal.desktop } Button { id=pcmanfm.desktop } } }
Plugin { type=taskbar expand=1 Config { tooltips=1 IconsOnly=0 } }
Plugin { type=tray }
Plugin { type=dclock Config { ClockFmt=%H:%M  TooltipFmt=%A %x  BoldFont=1 } }
