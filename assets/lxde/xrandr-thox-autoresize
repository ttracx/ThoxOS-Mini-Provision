#!/bin/sh
# ThoxOS Mini display auto-resize. UTM/SPICE often reports the virtual output as
# Virtual-1, but the name varies; pick the first connected output and --auto it.
# Workaround for the documented "auto resolution does not work" UTM bug.
OUT="$(xrandr 2>/dev/null | awk '/ connected/{print $1; exit}')"
[ -n "$OUT" ] || OUT="Virtual-1"
xrandr --output "$OUT" --auto 2>/dev/null || true
